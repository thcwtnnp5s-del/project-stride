google-services.json
GoogleService-Info.plist

# ---------------------------------------------------------------------------
# Dart and Flutter
# ---------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Package lockfiles: committed for the app, ignored for libraries, per Dart
# convention. Keeping the app's lock makes CI reproducible.
packages/stride_core/pubspec.lock
packages/stride_health/pubspec.lock

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
**/android/.gradle
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties

# Flutter's own generated android/.gitignore excludes gradlew and the wrapper
# jar, and Flutter regenerates them on build. CI therefore drives Android
# through `flutter build` rather than calling ./gradlew directly — a raw gradlew
# invocation would fail on a fresh checkout.

# ---------------------------------------------------------------------------
